{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sarj-long-running-agent-docs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  },
  "routes": [
    { "pattern": "engineering.sarj.ai", "custom_domain": true },
    { "pattern": "lra.sarj.ai", "custom_domain": true }
  ]
}
