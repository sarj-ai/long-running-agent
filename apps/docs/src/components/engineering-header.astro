---
import LOGO from "../../public/sarj-logo.svg?url&no-inline";

interface Props { githubHref?: string }
const { githubHref = "https://github.com/sarj-ai" } = Astro.props;
---

<header aria-label="Sarj Engineering" class="engineering-header">
  <div class="engineering-header-inner">
    <a aria-label="Sarj Engineering home" class="engineering-brand" href="/">
      <img alt="Sarj" class="engineering-logo" decoding="async" height="28" src={LOGO} width="50" />
    </a>
    <nav aria-label="Engineering links" class="engineering-header-actions">
      <button aria-label="Dark theme" aria-pressed="false" class="engineering-theme-toggle" data-engineering-theme-toggle disabled title="Change color theme" type="button">
        <svg aria-hidden="true" class="engineering-theme-moon" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" viewBox="0 0 24 24" width="16"><path d="M19.5 15.5A8 8 0 0 1 8.5 4.5a8 8 0 1 0 11 11Z" /></svg>
        <svg aria-hidden="true" class="engineering-theme-sun" fill="none" height="16" stroke="currentColor" stroke-linecap="round" stroke-width="1.75" viewBox="0 0 24 24" width="16"><circle cx="12" cy="12" r="4" /><path d="M12 1v3m0 16v3M1 12h3m16 0h3M4.2 4.2l2.1 2.1m11.4 11.4 2.1 2.1M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" /></svg>
      </button>
      <a class="engineering-github" href="https://sarj.ai/blog/">Blog</a>
      <a class="engineering-github" href={githubHref}>GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
