  .demo-accessible-tabs :global(button) { flex: 0 0 auto; white-space: nowrap; }
  .demo-accessible-tabs :global(button[aria-selected=true]) { background: #a6e3a1; color: #181825; }
  .demo-sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (min-width: 50rem) {
    .demo-accessible-tabs { position: absolute; bottom: 100%; left: 0.75rem; width: calc(100% - 1.5rem); background: #1e1e2e; }
    .demo-accessible-tabs:not(:focus-within) { width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  }
  @media (max-width: 35rem) {
    .demo-shortcuts { grid-template-columns: 1fr; }
    .demo-viewport { padding: 6px; }
