<section aria-busy="true" aria-label="Interactive terminal demo" class="terminal-demo not-content" data-terminal-demo>
  <div class="demo-help">
    <div data-instructions>
      <p class="demo-instructions">Click the terminal to use shortcuts.</p>
      <dl class="demo-shortcuts">
        <div><dt><kbd>Option</kbd> + <kbd>←</kbd> / <kbd>→</kbd></dt><dd>Switch panes / tabs</dd></div>
        <div><dt><kbd>Option</kbd> + <kbd>N</kbd></dt><dd>New tab</dd></div>
        <div><dt><kbd>Option</kbd> + <kbd>R</kbd></dt><dd>Rename tab</dd></div>
        <div><dt><kbd>Option</kbd> + <kbd>D</kbd></dt><dd>Detach</dd></div>
      </dl>
    </div>
  </div>
  <div class="demo-viewport"><div class="demo-terminal" data-terminal></div></div>
  <footer class="demo-footer">
    <span>Interactive demo · sample data · runs locally</span>
    <div aria-label="Sample terminal tabs" class="demo-accessible-tabs" data-accessible-tabs inert role="tablist"></div>
    <div class="demo-actions">
      <button data-submit disabled type="button">Connect ↵</button>
      <button data-detach disabled inert type="button">Detach</button>
      <button data-reset disabled type="button">Reset</button>
    </div>
  </footer>
  <pre aria-label="Current sample terminal transcript" aria-live="off" class="demo-sr-only" data-transcript></pre>
  <p aria-atomic="true" aria-live="polite" class="demo-sr-only" data-status></p>
  <noscript><p>Enable JavaScript to try the terminal demo.</p></noscript>
</section>

<script>
  import "@xterm/xterm/css/xterm.css";

  import { mountTerminalDemo } from "../lib/mount-terminal-demo";

  for (const root of document.querySelectorAll<HTMLElement>("[data-terminal-demo]")) void mountTerminalDemo(root);
</script>

<style>
  @font-face { font-family: LRATerminal; src: url("/projects/lra/fonts/lra-terminal-regular.woff2") format("woff2"); font-weight: 400; font-display: block; }
  @font-face { font-family: LRATerminal; src: url("/projects/lra/fonts/lra-terminal-bold.woff2") format("woff2"); font-weight: 700; font-display: block; }
  .terminal-demo { margin: 1.5rem 0 2rem; min-width: 0; border: 1px solid #313244; border-radius: 0.45rem; overflow: hidden; background: #1e1e2e; color: #cdd6f4; }
  .terminal-demo [hidden] { display: none !important; }
  .demo-help { padding: 0.65rem 0.85rem; border-bottom: 1px solid #313244; color: #bac2de; font: 0.76rem/1.5 var(--sl-font, sans-serif); }
  .demo-instructions { margin: 0 0 0.6rem; }
  .demo-shortcuts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.4rem 1.25rem; margin: 0; }
  .demo-shortcuts > div { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.15rem 0.55rem; }
  .demo-shortcuts dt { color: #cdd6f4; white-space: nowrap; }
  .demo-shortcuts dd { margin: 0; }
  .demo-shortcuts kbd { border: 1px solid #585b70; border-radius: 0.2rem; padding: 0.05rem 0.25rem; background: #313244; color: #cdd6f4; font: 0.95em/1.5 var(--sl-font-mono, monospace); }
  .demo-viewport { width: 100%; height: clamp(16rem, 45svh, 28rem); padding: 10px; overflow: hidden; }
  .terminal-demo:not([data-attached=true]) :is(.demo-accessible-tabs, [data-detach]) { visibility: hidden; }
  .demo-terminal { width: 100%; height: 100%; }
  .demo-terminal :global(.xterm) { height: 100%; background: #1e1e2e; }
  .demo-terminal :global(.xterm-viewport) { scrollbar-width: none; background: #1e1e2e !important; }
  .demo-terminal :global(.xterm-helper-textarea) { font-size: 16px !important; }
  .demo-terminal :global(.xterm:focus-within) { outline: none; }
  .demo-footer { position: relative; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.4rem 1rem; padding: 0.4rem 0.75rem; border-top: 1px solid #313244; color: #a6adc8; font: 0.7rem/1.5 var(--sl-font, sans-serif); }
  .demo-actions, .demo-accessible-tabs { display: flex; align-items: center; gap: 0.25rem; }
  .demo-accessible-tabs { position: relative; min-width: 0; height: 44px; flex-basis: 100%; overflow-x: auto; scrollbar-width: none; }
  .demo-accessible-tabs::-webkit-scrollbar { display: none; }
  .terminal-demo :global(button) { min-width: 44px; min-height: 44px; border: 0; border-radius: 0.3rem; padding: 0.3rem 0.6rem; background: transparent; color: #cdd6f4; font: inherit; cursor: pointer; }
  .terminal-demo :global(button:hover) { background: #313244; }
  .terminal-demo :global(button:focus-visible) { outline: 2px solid #89b4fa; outline-offset: -2px; }
  .terminal-demo :global(button:disabled) { opacity: 0.5; cursor: default; }
