---
import "../styles/engineering.css";

import EngineeringHeader from "../components/engineering-header.astro";
import EngineeringProjectCard from "../components/engineering-project-card.astro";
import EngineeringTheme from "../components/engineering-theme.astro";
import { ENGINEERING_PROJECTS } from "../lib/engineering-projects";
import { SITE_ORIGIN, siteHref } from "../lib/paths";

const CANONICAL = `${SITE_ORIGIN}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width,initial-scale=1" name="viewport" />
    <meta content="light dark" name="color-scheme" />
    <meta content="Documentation for Sarj's code checks, repository standards, terminals, and workspace tools." name="description" />
    <meta content="Sarj Engineering" property="og:title" />
    <meta content="Developer tools and documentation." property="og:description" />
    <meta content={CANONICAL} property="og:url" />
    <meta content="website" property="og:type" />
    <link href={CANONICAL} rel="canonical" />
    <link href={siteHref("/favicon.ico")} rel="icon" />
    <title>Sarj Engineering</title>
    <EngineeringTheme />
  </head>
  <body class="engineering-home">
    <a class="engineering-skip" href="#main-content">Skip to projects</a>
    <EngineeringHeader />
    <main id="main-content" tabindex="-1">
      <section class="engineering-intro engineering-band">
        <div class="engineering-frame engineering-intro-inner">
          <h1>Sarj Engineering</h1>
          <p class="engineering-summary">Developer tools and documentation.</p>
        </div>
      </section>
      <section aria-labelledby="projects-title" class="engineering-band">
        <div class="engineering-frame">
          <div class="engineering-section-heading"><h2 id="projects-title">Projects</h2></div>
          <ul aria-label="Engineering projects" class="engineering-project-grid">
            {ENGINEERING_PROJECTS.map((project) => <li><EngineeringProjectCard project={project} /></li>)}
          </ul>
        </div>
      </section>
    </main>
  </body>
</html>
