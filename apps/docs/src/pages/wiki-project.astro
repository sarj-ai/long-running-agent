---
import "@sarj/design/styles.css";
import "../styles/engineering.css";
import "../styles/wiki-project.css";

import { Image } from "astro:assets";

import NUNITO_LICENSE from "../assets/wiki/nunito-ofl.txt?url&no-inline";
import WIKI_SCREENSHOT from "../assets/wiki/wiki-demo.png";
import EngineeringHeader from "../components/engineering-header.astro";
import EngineeringTheme from "../components/engineering-theme.astro";
import { SITE_ORIGIN, siteHref } from "../lib/paths";
import { WIKI_DESCRIPTION } from "../lib/wiki-description";

const CANONICAL = `${SITE_ORIGIN}/projects/wiki/`;
---

<!doctype html>
<html data-theme="light" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width,initial-scale=1" name="viewport" />
    <meta content="light dark" name="color-scheme" />
    <meta content={WIKI_DESCRIPTION} name="description" />
    <meta content="Wiki · Sarj Engineering" property="og:title" />
    <meta content={WIKI_DESCRIPTION} property="og:description" />
    <meta content={CANONICAL} property="og:url" />
    <meta content="website" property="og:type" />
    <link href={CANONICAL} rel="canonical" />
    <link href={siteHref("/favicon.ico")} rel="icon" />
    <title>Wiki · Sarj Engineering</title>
    <EngineeringTheme />
  </head>
  <body class="wiki-project">
    <a class="engineering-skip" href="#main-content">Skip to Wiki</a>
    <EngineeringHeader githubHref="https://github.com/sarj-ai/wiki" />
    <main id="main-content" tabindex="-1">
      <article class="wiki-content">
          <header class="wiki-intro">
            <h1>Wiki</h1>
            <p class="wiki-summary">{WIKI_DESCRIPTION}</p>
            <div class="wiki-actions"><a aria-label="Demo (read-only, no sign-in)" class="wiki-primary" href="https://wiki.sarj.ai/demo">Demo <span aria-hidden="true">↗</span></a></div>
          </header>
          <section aria-label="Wiki preview" class="wiki-panel">
            <a aria-label="Open the Wiki demo" class="wiki-screenshot" href="https://wiki.sarj.ai/demo">
              <Image alt="Wiki demo with Latency workbook open and four files in the sidebar." decoding="async" fetchpriority="high" format="webp" loading="eager" quality={80} sizes="(min-width: 64rem) 58rem, calc(100vw - 2rem)" src={WIKI_SCREENSHOT} widths={[640, 960, 1440]} />
            </a>
          </section>
          <section aria-labelledby="wiki-features" class="wiki-panel wiki-details">
            <h2 id="wiki-features">Work with your documents</h2>
            <ul><li>Browse and search Google Drive.</li><li>Edit and format documents.</li><li>Connect agents through MCP.</li></ul>
            <p>Your Drive requires Google sign-in. The demo is read-only.</p>
            <nav aria-label="Wiki links" class="wiki-links"><a href="https://wiki.sarj.ai/">Open Wiki</a><a href="https://github.com/sarj-ai/wiki/issues">Issues</a><a href="https://github.com/sarj-ai/wiki/blob/main/LICENSE">MIT license</a><a href={NUNITO_LICENSE}>Font license</a></nav>
          </section>
      </article>
    </main>
  </body>
</html>
