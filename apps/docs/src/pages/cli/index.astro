---
import ReferencePage from "../../components/reference-page.astro";
import { commandHref, REFERENCE } from "../../lib/reference";
---

<ReferencePage title="CLI reference">
  <article class="reference-page">
    <h1>CLI reference</h1>
    <div aria-label="Reference table" class="reference-table-wrap" role="region" tabindex="0">
      <table class="reference-table">
        <caption>Entrypoints</caption>
        <thead><tr><th scope="col">Command</th><th scope="col">Help</th><th scope="col">Default / alias</th></tr></thead>
        <tbody>
          {REFERENCE.entrypoints.filter((entrypoint) => !entrypoint.command.hidden).map((entrypoint) => (
            <tr>
              <th scope="row"><a href={commandHref(entrypoint.command)}><code>{entrypoint.name}</code></a></th>
              <td class="source-prose">{entrypoint.command.help}</td>
              <td>
                {entrypoint.defaultCommand && <code>{entrypoint.defaultCommand}</code>}
                {entrypoint.aliasOf && <small>Alias: <code>{entrypoint.aliasOf}</code></small>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </article>
</ReferencePage>
