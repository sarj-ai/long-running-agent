---
import ReferencePage from "../../components/reference-page.astro";
import { commandHref, CONNECTION_COMMANDS } from "../../lib/reference";
---

<ReferencePage title="Commands">
  <article class="reference-page">
    <h1>Commands</h1>
    <nav aria-label="Commands" class="command-list">
      {CONNECTION_COMMANDS.map((command) => (
        <a href={commandHref(command)}>
          <strong><code>{command.path.join(" ")}</code></strong>
          <span>{command.help}</span>
        </a>
      ))}
    </nav>
    <p><code>vm</code> opens your terminal. <code>vm browser</code> and <code>vm info</code> work too.</p>
    <p><code>sarj-vm</code> remains an alias for <code>vm</code>.</p>
  </article>
</ReferencePage>
