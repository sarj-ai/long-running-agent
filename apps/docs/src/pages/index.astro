---
import { Code } from "@astrojs/starlight/components";

import ReferencePage from "../components/reference-page.astro";
import { REFERENCE } from "../lib/reference";
---

<ReferencePage title={REFERENCE.package.name}>
  <article class="sarj-about-page">
    <h1>{REFERENCE.package.name}</h1>
    <p>{REFERENCE.package.description}</p>
    <dl class="metadata-list">
      <div><dt>Version</dt><dd><code>{REFERENCE.package.version}</code></dd></div>
      <div><dt>Python</dt><dd><code>{REFERENCE.package.requiresPython}</code></dd></div>
      <div><dt>License</dt><dd>{REFERENCE.package.license}</dd></div>
    </dl>
    <section>
      <h2>Install</h2>
      <Code code={REFERENCE.package.install.join("\n")} lang="bash" />
    </section>
    <section>
      <h2>Reference</h2>
      <nav aria-label="Reference" class="reference-links">
        <a href="/cli/">CLI</a><a href="/api/">Python API</a><a href="/settings/">Settings</a><a href="/terraform/">Terraform</a>
      </nav>
    </section>
    <section>
      <h2>Dependencies</h2>
      <ul class="dependency-list">{REFERENCE.package.dependencies.map((dependency) => <li><code>{dependency}</code></li>)}</ul>
    </section>
    <section class="sarj-related-standards">
      <a href={REFERENCE.package.repository}>Source</a>
      <span aria-hidden="true"> · </span>
      <a href="/reference.json">Generated reference JSON</a>
    </section>
  </article>
</ReferencePage>
