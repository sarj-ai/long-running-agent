---
import { Code } from "@astrojs/starlight/components";

import ReferencePage from "../../components/reference-page.astro";
import { REFERENCE, sourceHref } from "../../lib/reference";
---

<ReferencePage title="Python API">
  <article class="reference-page">
    <h1>Python API</h1>
    <Code code={`from long_running_agent import ${REFERENCE.api.map((item) => item.name).join(", ")}`} lang="python" />
    {REFERENCE.api.map((item) => (
      <section class="api-symbol" id={item.name}>
        <h2><code>{item.name}</code></h2>
        <Code code={item.signature} lang="python" />
        {item.doc && <p class="source-prose">{item.doc}</p>}
        <a class="source-link" href={sourceHref(item.source)}>{item.source}</a>
        {item.methods.map((method) => (
          <section id={`${item.name}-${method.name}`}>
            <h3><code>{method.name}</code></h3>
            <Code code={method.signature} lang="python" />
            {method.doc && <p class="source-prose">{method.doc}</p>}
          </section>
        ))}
      </section>
    ))}
  </article>
</ReferencePage>
