      ]
    },
    {
      "id": "cloud-power-and-tunnel",
      "oldRepresentation": "native instance status, tunnel ownership, ephemeral ports",
      "authoritativeReplacement": "typed PowerAction and native Cloud command result checks; connection owner context",
      "events": [
        "start",
        "resume",
        "wait",
        "SSH connect",
        "tunnel exit"
      ],
      "guards": [
        "instance identity",
        "host key validation",
        "bounded process lifetime",
        "owned port"
      ],
      "recovery": "GCP/SSH own durable status; failures propagate and owned child processes close",
      "decision": "retain-explicit",
      "sources": [
        "client/cloud.py",
        "client/connection.py",
        "client/browser.py"
      ]
    },
    {
      "id": "transfer",
      "oldRepresentation": "path/descriptor/size/hash combinations",
      "authoritativeReplacement": "PreparedFile, FileState, TransferControl and exact file readback",
      "events": [
