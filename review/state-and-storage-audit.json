{
  "scope": "All tracked CLI, runtime, setup, browser, SSH, maintenance and infrastructure sources; native Codex durable storage is a separately owned provider boundary.",
  "machines": [
    {
      "id": "capacity-retry",
      "oldRepresentation": "phase plus unconstrained count/due/error fields",
      "authoritativeReplacement": "codex_retry_state.Attempt closed union; observe_capacity, acknowledged, uncertain",
      "events": [
        "capacity observed",
        "deadline",
        "dispatch",
        "acknowledge",
        "unknown delivery",
        "new error"
      ],
      "guards": [
        "secure fsynced ledger",
        "one shared account/retry flock",
        "verified foreground native pane",
        "same process/home/thread",
        "bounded retry budget"
      ],
      "recovery": "v1 receipt migration preserves count and cursor; dispatching becomes uncertain; time never clears uncertainty",
      "decision": "convert",
      "sources": [
        "runtime/codex_retry_state.py",
        "runtime/codex_recovery.py"
      ]
    },
    {
      "id": "native-turn-observation",
      "oldRepresentation": "completion state and optional fingerprint; generic native payload",
      "authoritativeReplacement": "ObservedCompletion | CapacityCompletion and typed native record variants",
      "events": [
        "task_started",
        "user_message",
        "response_item tool/input/output",
        "task_complete",
        "turn_aborted"
      ],
      "guards": [
        "bounded private tail",
        "matching open fd/inode snapshot",
        "malformed recognized event fails closed"
      ],
      "recovery": "tool activity supersedes earlier completion; unknown never authorizes resend",
      "decision": "convert",
      "sources": [
        "runtime/codex_events.py"
      ]
    },
    {
      "id": "native-rpc",
      "oldRepresentation": "optional id/method/result/error bag",
      "authoritativeReplacement": "RpcNotification | RpcServerRequest | RpcSuccess | RpcFailure; runtime RootModel",
      "events": [
        "receive",
        "request reply",
        "notification",
        "login completion"
      ],
      "guards": [
        "strict boundary union",
        "exact request ID",
        "bounded subprocess communication"
      ],
      "recovery": "unsupported or malformed replies fail closed; native Codex owns durable tool checkpoints",
      "decision": "convert",
      "sources": [
        "runtime/codex.py"
      ]
    },
    {
      "id": "host-bridge",
      "oldRepresentation": "action/path and ok/paths bags",
      "authoritativeReplacement": "HostCommand | DownloadRequest; HostSuccess | HostFailure",
      "events": [
        "connect",
        "status",
        "browser",
        "image",
        "download",
        "disconnect"
      ],
      "guards": [
        "private Unix socket",
        "bounded payload and connections",
        "path validation",
        "prepared descriptor identity"
      ],
      "recovery": "context manager closes sockets and server workers; failed requests contain no success paths",
      "decision": "convert",
      "sources": [
        "host_connection.py",
        "client/host.py",
        "runtime/host.py"
      ]
    },
    {
      "id": "growth-observation",
      "oldRepresentation": "four independent optional measurements",
      "authoritativeReplacement": "NoGrowthSamples | TrackingGrowth",
      "events": [
        "sample",
        "gap",
        "noise",
        "reclaim",
        "reset"
      ],
      "guards": [
        "finite bounded sample policy",
        "same filesystem target",
        "minimum samples/horizon"
      ],
      "recovery": "restart starts fresh; partial samples cannot predict cleanup",
      "decision": "convert",
      "sources": [
        "runtime/cleanup_daemon.py"
      ]
    },
    {
      "id": "cleanup-schedule",
      "oldRepresentation": "phase with deadlines, failure/backoff and report facts",
      "authoritativeReplacement": "Phase literal; Schedule.restore exhaustive cases; Schedule deadline/selection methods",
      "events": [
        "poll",
        "deadline",
        "pressure",
        "budget",
        "worker start",
        "worker report",
        "stop",
        "crash"
      ],
      "guards": [
        "one daemon lock",
        "stop Event",
        "bounded failure history",
        "watchdog",
        "provider-native worktree remove only"
      ],
      "recovery": "running heartbeat on restart becomes error; stopped becomes waiting; output/timeout/worker failure remains failure. Counters and capacity samples are independent facts valid in every phase, not conditional state payloads",
      "decision": "simplify",
      "sources": [
        "runtime/cleanup_daemon.py"
      ]
    },
    {
      "id": "cleanup-worker",
      "oldRepresentation": "subprocess/selector/stop/deadline lifecycle",
      "authoritativeReplacement": "ChildProcess context manager, WorkerReport boundary schema and FailureStage/FailureKind literals",
      "events": [
        "spawn",
        "output",
        "exit",
        "timeout",
        "cancel"
      ],
      "guards": [
        "bounded report/output",
        "PID identity",
        "owned child process",
        "stop and reap"
      ],
      "recovery": "failure receipts persist separately; failed inspection never authorizes removal",
      "decision": "retain-explicit",
      "sources": [
        "runtime/cleanup_daemon.py",
        "process.py"
      ]
    },
    {
      "id": "cleanup-publication",
      "oldRepresentation": "branch remote PR states and local worktree graph",
      "authoritativeReplacement": "typed provider response schemas and canonical publication checks",
      "events": [
        "inspect local graph",
        "read refs",
        "read PR",
        "decide retain/remove"
      ],
      "guards": [
        "fresh remote truth",
        "exact commit/head",
        "unpublished or changed branches retained"
      ],
      "recovery": "provider failure or uncertainty retains source; provider PR lifecycle remains GitHub-owned",
      "decision": "retain-explicit",
      "sources": [
        "runtime/cleanup_publication.py"
      ]
    },
    {
      "id": "cleanup-attempt-budget",
      "oldRepresentation": "receipt/cursor files",
      "authoritativeReplacement": "AttemptStamp, AttemptReceipt, AttemptHistory, ReviewCursor, InventoryCursor runtime schemas",
      "events": [
        "reserve attempt",
        "advance review",
        "checkpoint inventory",
        "new stamp"
      ],
      "guards": [
        "atomic private write",
        "fsync",
        "bounded reads",
        "same native model/capacity fingerprint"
      ],
      "recovery": "reserve before action; crash spends budget conservatively; malformed advisory quarantined, protective evidence retained",
      "decision": "retain-explicit",
      "sources": [
        "runtime/cleanup_state.py"
      ]
    },
    {
      "id": "worktree-deletion",
      "oldRepresentation": "filesystem/git/index/activity across local/native state",
      "authoritativeReplacement": "native identity snapshots, inventory classifications and cleanup eligibility checks",
      "events": [
        "discover",
        "inspect",
        "revalidate",
        "native remove",
        "readback"
      ],
      "guards": [
        "fresh activity including tool checkpoints",
        "Git process ownership",
        "native worktree remove",
        "identity/version checks"
      ],
      "recovery": "no manual source deletion; unknown activity, publication or provenance retains worktree",
      "decision": "retain-explicit",
      "sources": [
        "runtime/cleanup.py",
        "runtime/worktrees.py",
        "runtime/cleanup_activity.py"
      ]
    },
    {
      "id": "capacity-calibration",
      "oldRepresentation": "disk samples and thresholds",
      "authoritativeReplacement": "Calibration/LowerObservation/Policy schemas",
      "events": [
        "explicit post-cleanup calibration",
        "sample",
        "select"
      ],
      "guards": [
        "fresh mount identity",
        "signed ownership/private files",
        "threshold validation"
      ],
      "recovery": "missing or invalid calibration prevents speculative reclaim; measurements are immutable input facts",
      "decision": "retain-explicit",
      "sources": [
        "runtime/cleanup_capacity.py"
      ]
    },
    {
      "id": "native-process-ownership",
      "oldRepresentation": "pid/start time/session/tty/home/thread and foreground combinations",
      "authoritativeReplacement": "ProcessIdentity, PaneTarget, ScreenProcess and verified target inventory",
      "events": [
        "discover",
        "inspect",
        "focus",
        "reopen",
        "interrupt"
      ],
      "guards": [
        "pidfd/start-time validation",
        "foreground group",
        "same uid/session/home",
        "restricted pane target"
      ],
      "recovery": "stale or ambiguous process stays blocked; process-local resources use structured ownership and finally cleanup",
      "decision": "retain-explicit",
      "sources": [
        "runtime/codex_panes.py",
        "process.py"
      ]
    },
    {
      "id": "account-switch",
      "oldRepresentation": "login notifications/process exit/account profiles",
      "authoritativeReplacement": "typed native RPC and account provider boundary models; shared recovery lock",
      "events": [
        "begin device login",
        "notify",
        "read account",
        "switch",
        "refresh"
      ],
      "guards": [
        "same account lock as retry dispatch",
        "native authorization readback",
        "deadline"
      ],
      "recovery": "no tools are replayed by account switching; malformed/unsupported account data errors",
      "decision": "retain-explicit",
      "sources": [
